vndbinder_use(hal_camera_default)
hal_client_domain(hal_camera_default, hal_thermal)
binder_call(system_server, hal_camera_default)

allow hal_camera_default rild:unix_stream_socket connectto;

set_prop(hal_camera_default, vendor_camera_prop)
get_prop(hal_camera_default, exported_camera_prop)
dontaudit hal_camera_default default_prop:file read;

allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;
hal_client_domain(hal_camera_default, hal_graphics_allocator)
allow hal_camera_default system_server:binder call;

allow hal_camera_default jsqz_device:chr_file rw_file_perms;
allow hal_camera_default npu_device:chr_file rw_file_perms;

allow hal_camera_default app_efs_file:dir r_dir_perms;
allow hal_camera_default app_efs_file:file r_file_perms;
allow hal_camera_default efs_file:dir r_dir_perms;
allow hal_camera_default efs_file:file r_file_perms;

allow hal_camera_default sysfs_camera_writable:file rw_file_perms;
allow hal_camera_default sysfs_camera_writable:dir search;
allow hal_camera_default sysfs_gpu:file r_file_perms;
allow hal_camera_default sysfs_gpu:dir search;
allow hal_camera_default sysfs_memboost_writable:file rw_file_perms;

allow hal_camera_default proc_meminfo:file r_file_perms;

allow hal_camera_default dmabuf_heap_device:chr_file r_file_perms;

allow hal_camera_default self:capability sys_nice;

allow hal_camera_default hal_graphics_composer_default:fd use;
